{
  "manifest_version": 3,
  "name": "快速复制助手",
  "version": "1.2.0",
  "description": "在指定 XPath 的输入框下方显示「快速复制」按钮，在 audio 标签下方显示「识别语音」按钮，一键填入目标输入框。",
  "permissions": ["storage", "activeTab", "clipboardWrite"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "快速复制助手"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ]
}
