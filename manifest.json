{
  "manifest_version": 3,
  "name": "语音识别助手",
  "version": "2.0.0",
  "description": "自动识别页面中的 audio 播放器，在播放器下方添加「语音识别」按钮，点击后把音频文件提交到指定接口并展示返回结果。",
  "permissions": ["storage", "activeTab"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "语音识别助手"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ]
}
